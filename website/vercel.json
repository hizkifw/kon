{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/install.sh",
      "destination": "https://raw.githubusercontent.com/hizkifw/kon/main/scripts/install.sh",
      "permanent": false
    },
    {
      "source": "/install.ps1",
      "destination": "https://raw.githubusercontent.com/hizkifw/kon/main/scripts/install.ps1",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "query",
          "key": "go-get",
          "value": "1"
        }
      ],
      "destination": "/"
    }
  ]
}
